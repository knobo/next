          "expr": "sum by (estimate_model, estimate) (board_task_estimate_tokens_total{project=~\"$project\"})\n  /\nsum by (estimate_model, estimate) (board_tasks_estimate_costed_total{project=~\"$project\"})",
          "legendFormat": "{{estimate_model}} \u2014 st\u00f8rrelse {{estimate}}",
          "refId": "A"
        }
      ],
      "title": "Faktisk kostnad per estimert st\u00f8rrelse, per modell",
      "type": "barchart"
    },
